# Frontend environment variables (Vite)
# Copy to .env and fill in values. These are bundled into the JS at build time
# and are visible to any browser user — do NOT put real secrets here.

# Backend API base URL
VITE_API_BASE=http://localhost:3001

# Global API key — must match the backend API_KEY env var.
# This is a weak gate (prevents scan bots), not a real secret.
VITE_API_KEY=dev-local-key
