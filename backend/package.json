{
  "name": "five-eyes-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env -r dotenv/config dist/db/migrate.js",
    "db:push": "bash scripts/db-push.sh"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.1",
    "pg": "^8.11.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/pg": "^8.11.0",
    "@types/uuid": "^10.0.0",
    "dotenv": "^16.0.0",
    "drizzle-kit": "^0.31.9",
    "typescript": "^5.4.0"
  }
}
