# ─── REQUIRED ────────────────────────────────────────────────────────────────
# Server will refuse to start if these are missing.

# PostgreSQL connection string
DATABASE_URL=postgresql://five_eyes_user:five_eyes_dev@localhost:5433/five_eyes_v2

# Global API key — all requests must supply this via x-api-key header (or ?x-api-key= for SSE)
API_KEY=dev-local-key

# ─── REQUIRED FOR FIRST RUN (or until at least one admin exists in DB) ───────
# Initial password seeded to all admin accounts listed in server.ts.
# Change each account's password via /admin/profile/change-password after first login.
# Server fails fast on startup if unset AND no admin accounts exist in the DB.
ADMIN_PASSWORD=changeme

# ─── OPTIONAL — must be set correctly for production ─────────────────────────

# Backend port (default: 3001)
PORT=3001

# Allowed CORS origin for the frontend.
# Defaults to http://localhost:5173 (dev only). MUST be set to the production frontend URL.
CORS_ORIGIN=http://localhost:5173

# Trust proxy depth — number of proxy layers in front of this server.
# Required for correct client IP detection in rate limiters behind a reverse proxy or load balancer.
# Set to 1 for a single proxy (e.g. Nginx or ALB), 2 for two layers, etc.
# Leave unset for direct connections (no proxy). Produces a startup warning if unset.
TRUST_PROXY=1

# ─── OPTIONAL — feature-specific ─────────────────────────────────────────────

# OpenAI API key — required for learner KB chat (/learn/modules/chat) and TTX AI assist (/ttx/assist/*).
# If unset, those endpoints return 503 gracefully. All other features work without it.
OPENAI_API_KEY=

# Email delivery — priority: SES → SMTP → stdout
# AWS SES (production):
#   SES_FROM_ADDRESS must be a verified SES identity. AWS_REGION must match.
SES_FROM_ADDRESS=
AWS_REGION=us-east-1
# SMTP relay (dev/staging, e.g. Mailpit):
#   brew install mailpit && mailpit  →  web UI: http://localhost:8025
#   Then set SMTP_HOST=localhost  SMTP_PORT=1025 in .env
SMTP_HOST=
SMTP_PORT=1025

# Public base URL of the frontend — used to construct assessment links in emails.
# Example: https://app.fiveeyesltd.com
APP_BASE_URL=http://localhost:5173
